{
  "name": "@pi-web/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/static": "^10.0.0",
    "@fastify/websocket": "^11.0.0",
    "@pi-web/config": "workspace:*",
    "@pi-web/ipc": "workspace:*",
    "@pi-web/protocol": "workspace:*",
    "@pi-web/shared": "workspace:*",
    "fastify": "^5.0.0",
    "fflate": "^0.8.3",
    "node-pty": "1.1.0",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4"
  }
}
