{
  "name": "@pi-web/sessiond",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@pi-web/config": "workspace:*",
    "@pi-web/ipc": "workspace:*",
    "@pi-web/pi-rpc": "workspace:*",
    "@pi-web/pi-session-reader": "workspace:*",
    "@pi-web/protocol": "workspace:*",
    "@pi-web/scheduler-extension": "workspace:*",
    "@pi-web/shared": "workspace:*",
    "cron-parser": "^5.0.0",
    "zod": "^4.0.0"
  }
}
