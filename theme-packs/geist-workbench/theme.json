{
  "schemaVersion": 2,
  "id": "geist-workbench",
  "name": "Geist Workbench",
  "version": "2.1.1",
  "description": "亮暗双模式、高对比黑白、精细边框与紧凑几何层级的开发工作台；参考 Vercel Geist，非官方主题。",
  "author": "Pi Web",
  "schemes": {
    "light": {
      "tokens": {
        "--bg": "#fafafa",
        "--bg-raised": "#ffffff",
        "--panel": "#ffffff",
        "--panel-2": "#fafafa",
        "--panel-3": "#f2f2f2",
        "--line": "#dedede",
        "--line-soft": "#ebebeb",
        "--text": "#1d1d1f",
        "--text-soft": "#555555",
        "--text-dim": "#777777",
        "--lime": "#000000",
        "--lime-ink": "#ffffff",
        "--teal": "#0070f3",
        "--violet": "#7928ca",
        "--amber": "#b25e09",
        "--red": "#d93036",
        "--blue": "#0070f3",
        "--shadow": "0 12px 32px rgb(0 0 0 / 8%)",
        "--radius": "8px",
        "--radius-sm": "6px",
        "--font-ui": "Geist, Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
        "--font-mono": "\"Geist Mono\", \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace"
      }
    },
    "dark": {
      "tokens": {
        "--bg": "#000000",
        "--bg-raised": "#0a0a0a",
        "--panel": "#0a0a0a",
        "--panel-2": "#111111",
        "--panel-3": "#1a1a1a",
        "--line": "#333333",
        "--line-soft": "#242424",
        "--text": "#ededed",
        "--text-soft": "#a1a1a1",
        "--text-dim": "#7d7d7d",
        "--lime": "#ffffff",
        "--lime-ink": "#000000",
        "--teal": "#52a8ff",
        "--violet": "#bf7af0",
        "--amber": "#f5a623",
        "--red": "#ff6b6b",
        "--blue": "#52a8ff",
        "--shadow": "0 16px 40px rgb(0 0 0 / 44%)",
        "--radius": "8px",
        "--radius-sm": "6px",
        "--font-ui": "Geist, Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
        "--font-mono": "\"Geist Mono\", \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace"
      }
    }
  },
  "css": "theme.css"
}
