PI_WEB_HOST=0.0.0.0
PI_WEB_PORT=8787
PI_WEB_ALLOWED_ROOTS=/home/your-user
PI_WEB_DEFAULT_TIMEZONE=UTC
PI_WEB_PI_EXECUTABLE=pi
# Enable only when Pi Web is reachable exclusively through a trusted proxy.
PI_WEB_TRUSTED_PROXY=false
# Use "always" when TLS is terminated before requests reach Pi Web.
PI_WEB_COOKIE_SECURE=auto
